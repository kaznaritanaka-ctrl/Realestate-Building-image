{
  // 土地の未来図：静的アセット＋API Worker
  "name": "realestate-site",
  "main": "worker/index.ts",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/go/*"]
  },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RL_EVENT", "namespace_id": "20261101", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_SITEINFO", "namespace_id": "20261102", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "20261103", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "realestate-db", "database_id": "2a185765-498e-483f-a518-efb83fc4d707", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "realestate.ai-investment-research.net", "custom_domain": true }
  ]
  // シークレット：REINFOLIB_KEY（不動産情報ライブラリのAPIキー）は `wrangler secret put` またはダッシュボードで設定
}
